#!/usr/bin/env sh
# Show which plugin configuration and entrypoints match the installed OpenCode.
set -eu

binary=${OPENCODE_BIN:-opencode}
if ! version=$("$binary" --version 2>/dev/null); then
  echo "Unable to run '$binary --version'" >&2
  exit 1
fi
version=$(printf '%s\n' "$version" | head -n 1 | sed -nE 's/^[^0-9]*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p')
case $version in
  1.*)
    echo "OpenCode $version: use tui.json (V1) and each plugin's V1 entrypoint."
    ;;
  2.*)
    echo "OpenCode $version: use global cli.json (V2) and each plugin's ./tui entrypoint."
    ;;
  *)
    echo "Unsupported or unrecognized OpenCode version: $version" >&2
    exit 1
    ;;
esac
